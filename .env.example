# Copy to .env and fill in. Never commit real values. .env is gitignored.

# --- Model (server-side only) ---
# gemini is the only provider implemented so far.
SIDEQUEST_MODEL_PROVIDER=gemini
# Create a key in Google AI Studio. The free tier may use your content to improve Google's
# products, so use synthetic data only while on it.
GEMINI_API_KEY=
# Optional; defaults to the model in server/agent/config.py. Use an ID from Google's model list.
GEMINI_MODEL=
# Free-tier quotas are per model. When the main model's daily quota is used up, new runs move to these
# (comma separated; write none to disable; leave blank for the defaults in server/agent/config.py).
GEMINI_FALLBACK_MODELS=

# --- Supabase (auth, Postgres, realtime) -- not used yet ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Data providers (see docs/BUILD_PLAN.md section 12; verify access with test calls) -- not used yet ---
PLACES_API_KEY=
ROUTES_API_KEY=
EVENTS_API_KEY=
# Open-Meteo free tier is noncommercial; check terms before commercial use.
